{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["SqlMembership"]
    },
    "source": {
      "type": "object",
      "properties": {
        "manager": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "depth": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "filter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "identityTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["users", "agents"]
      }
    },
    "exclusionary": {
      "type": "boolean"
    }
  },
  "required": ["type", "source"],
  "additionalProperties": false
}
