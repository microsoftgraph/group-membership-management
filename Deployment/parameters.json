    "sharepointDomain": {
      "value": "m365x00000000.sharepoint.com",
      "metadata": {
        "description": "The SharePoint domain of the tenant."
      }
    },
    "tenantDomain": {
      "value": "m365x00000000.onmicrosoft.com",
      "metadata": {
        "description": "The domain of the tenant."
      }
    },
    "appConfigurationDataOwners": {
      "value": [
        {
          "principalId": "<guid>",
          "principalType": "Device|ForeignGroup|Group|ServicePrincipal|User"
        }
      ],
      "metadata": {
        "description": "The list of data owners for the App Configuration. principalId is the object id of the user, group, or service principal. principalType is the type of the principal, pick only one value."
      }
    },
    "authenticationType": {
      "value": "UserAssignedManagedIdentity|ClientSecret|Certificate",
      "metadata": {
        "description": "The type of authentication to use for the App Configuration. UserAssignedManagedIdentity is recommended and will use <solution>-identity-<environment>-Graph. ClientSecret and Certificate will use <solution>-Graph-<environment>."
      }
    },
    "graphAppCertificateName": {
      "value": "not-set",
      "metadata": {
        "description": "The name of the certificate in the Key Vault. This is required if the authenticationType is Certificate. This is only used by application <solutionAbbreviation>-Graph-<EnvironmentAbbreviation>. See https://learn.microsoft.com/en-us/azure/key-vault/certificates/quick-create-portal for more information on certificates."
      }
    },
    "teamsChannelAppCertificateName": {
      "value": "not-set",
      "metadata": {
        "description": "The name of the certificate in the Key Vault. This is required if the authenticationType is Certificate. This is only used by application <solutionAbbreviation>-TeamsChannel-<EnvironmentAbbreviation>. See https://learn.microsoft.com/en-us/azure/key-vault/certificates/quick-create-portal for more information on certificates."
      }
    },
    "pipeline": {
      "value": "PopulateDestinationPipeline_demo"
    },
    "setRBACPermissions": {
      "value": true,
      "metadata": {
        "description": "Flag to set RBAC permissions for the service principals from the script."
      }
    },
    "setRBACPermissionsBicep": {
      "value": true,
      "metadata": {
        "description": "Flag to set RBAC permissions for some service principals from the bicep templates."
      }
    },
    "createAppRegistrations": {
      "value": true,
      "metadata": {
        "description": "Flag to create and set up the App Registrations leveraged by GMM."
      }
    },
    "applyDBMigrations": {
      "value": true,
      "metadata": {
        "description": "Flag to apply database migrations."
      }
    },
    "skipAppRegistrationSetupIfAppExists": {
      "value": false,
      "metadata": {
        "description": "Flag to skip the app registration setup (API permissions). Set it to true to speed up the deployment if your App Registrations are already up to date with the required API permissions."
      }
    },
    "createResourceGroups": {
      "value": false,
      "metadata": {
        "description": "Flag to create resource groups. Set to true on initial deployment."
      }
    },
    "aiLocation": {
      "value": "westus3",
      "metadata": {
        "description": "Location of AI resources. Default is westus3."
      }
    },
