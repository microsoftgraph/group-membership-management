{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["GroupMembership"]
      },
      "source": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "minLength": 36,
        "maxLength": 36
      },
      "exclusionary": {
        "type": "boolean"
      }
    },
    "required": ["type", "source"],
    "additionalProperties": false
  }
}
