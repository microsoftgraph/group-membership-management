{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["SqlMembership"]
      },
      "source": {
        "type": "object",
        "anyOf": [
          {
            "required": ["manager"]
          },
          {
            "required": ["filter"]
          }
        ],
        "properties": {
          "manager": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "depth": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["id"],
            "additionalProperties": false
          },
          "filter": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "exclusionary": {
        "type": "boolean"
      }
    },
    "required": ["type", "source"],
    "additionalProperties": false
  }
}
