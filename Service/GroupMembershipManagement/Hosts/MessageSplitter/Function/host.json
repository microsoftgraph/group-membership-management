{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "extensions": {
    "durableTask": {
      "extendedSessionsEnabled": true,
      "extendedSessionIdleTimeoutInSeconds": 30
    },
    "serviceBus": {
      "autoCompleteMessages": false,
      "maxConcurrentCalls": 1,
      "prefetchCount": 0,
      "maxMessageBatchSize": 1
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  }
}