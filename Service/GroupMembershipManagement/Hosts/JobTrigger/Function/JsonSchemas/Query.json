{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Query",
  "type": "array",
  "items": {
    "$ref": "#/definitions/Query"
  },
  "definitions": {
    "Query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "array",
            "object"
          ]
        },
        "exclusionary": {
          "type": "boolean"
        },
        "identityTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "users",
              "agents"
            ]
          }
        }
      },
      "anyOf": [
        {
          "not": {
            "required": [
              "identityTypes"
            ]
          }
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "SqlMembership"
              ]
            }
          }
        }
      ]
    }
  }
}